if(NOT DEFINED ROOT OR NOT DEFINED PREFIX)
  message(FATAL_ERROR "ROOT and PREFIX are required")
endif()
foreach(path "bin/shairport-2" "bin/shairport-2-nqptp"
    "share/man/man1/shairport-2.1" "share/doc/shairport-2/README.md"
    "lib/systemd/user/shairport-2.service"
    "lib/systemd/system/shairport-2-nqptp.service")
  if(NOT EXISTS "${ROOT}${PREFIX}/${path}")
    message(FATAL_ERROR "Missing program identity artifact: ${path}")
  endif()
endforeach()
if(NOT EXISTS "${ROOT}/etc/shairport-2.conf.sample")
  message(FATAL_ERROR "Missing renamed sample configuration")
endif()
file(GLOB_RECURSE entries "${ROOT}${PREFIX}/*" "${ROOT}/etc/*")
foreach(entry IN LISTS entries)
  if(entry MATCHES "/shairport-sync[^/]*$")
    message(FATAL_ERROR "Legacy program identity still installed: ${entry}")
  endif()
endforeach()
file(READ "${ROOT}${PREFIX}/lib/systemd/user/shairport-2.service" unit)
string(FIND "${unit}" "ExecStart=${PREFIX}/bin/shairport-2\n" position)
if(position EQUAL -1)
  message(FATAL_ERROR "Receiver service does not launch the renamed binary")
endif()
if(DEFINED PACKAGE)
  execute_process(COMMAND dpkg-deb -f "${PACKAGE}" Package
    RESULT_VARIABLE status OUTPUT_VARIABLE name OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status EQUAL 0 OR NOT name STREQUAL "shairport-2")
    message(FATAL_ERROR "Unexpected Debian package identity: ${name}")
  endif()
endif()
